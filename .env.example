# このファイルをコピーして .env を作成し、値を埋めてください(ローカル実行用)。
# 本番(GitHub Actions)ではリポジトリの Secrets に同名で登録します。

GEMINI_API_KEY=
# 将来のモデル廃止・変更に備え、コード側では固定せず環境変数で指定する
GEMINI_MODEL=gemini-2.5-flash

SLACK_WEBHOOK_URL=
# 未設定ならSLACK_WEBHOOK_URLと同じ宛先にエラー通知される
SLACK_ERROR_WEBHOOK_URL=

RSS_URL=

SUPABASE_URL=
SUPABASE_KEY=

# Webサイトへの自動反映。運用初期はfalse推奨(Slackのみで様子を見る)
ENABLE_WEBSITE_PUBLISH=false

# 何時間おきに投稿処理を行うか(既定48時間 = 2日に1回)
RUN_INTERVAL_HOURS=48
